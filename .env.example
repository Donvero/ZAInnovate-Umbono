# Umbono - Offline-First AI Education Engine
# ZAInnovate Technologies (Pty) Ltd - East London, South Africa

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://umbono_admin:secure_password@localhost:5432/zainnovate_umbono?schema=public"

# Sovereign AI Inference Gateway (for online delta sync / model weights)
UMBONO_AI_EDGE_ENDPOINT="http://localhost:8001/v1"
UMBONO_API_KEY="umbono_dev_token"

# Content Delivery & Zero-Rating CDN Endpoints
CDN_EDUCATIONAL_ASSETS="https://cdn.umbono.co.za"
ZERO_RATING_PARTNER_GATEWAY="https://gateway.mtn-vodacom-education.co.za"

# Application Settings
NODE_ENV="development"
ENABLE_PWA_SERVICE_WORKER="true"
MAX_OFFLINE_STORAGE_MB="500"
